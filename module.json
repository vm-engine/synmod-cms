{
    "id": "cms",
    "id_case": {
        "snake": "cms",
        "pascal": "Cms",
        "slug": "cms",
        "studly": "Cms"
    },
    "name": "CMS",
    "description": "Content Management System — static pages, dynamic articles, gallery, and frontend menu management",
    "version": "2.2.0",
    "author": "Adods",
    "email": "theadods@gmail.com",
    "url_prefix": "cms",
    "load_priority": 60,
    "is_package": true,
    "primary_locale": null,
    "language_names": {},
    "language_icons": {},
    "search": {
        "engine": "database",
        "scout_content_limit": 5000,
        "slug": "search",
        "per_page": 10,
        "rate_limit": 30,
        "suggest_rate_limit": 120,
        "popular_min_hits": 3,
        "popular_limit": 8
    },
    "analytics": {
        "fake": false
    },
    "dependencies": {
        "npm": {
            "main": {
                "jodit": "^4.15",
                "tinymce": "^7.0",
                "sortablejs": "^1.15"
            },
            "dev": {}
        },
        "composer": {
            "main": {
                "vm-engine/synapps-fallback": "*",
                "vm-engine/synmod-fm": "*",
                "mews/purifier": "^3.4"
            },
            "dev": {}
        }
    },
    "nav": {
        "backend": {
            "name": "__cms::menu.be.parent",
            "position": 5,
            "class": "",
            "icon": "fa-solid fa-newspaper",
            "acl": "cms.any",
            "sub": {
                "page": {
                    "id": "page",
                    "name": "__cms::menu.be.page",
                    "class": "",
                    "route": "cms.page.index",
                    "icon": "fa-solid fa-file-lines",
                    "acl": "cms.page.read"
                },
                "section": {
                    "id": "section",
                    "name": "__cms::menu.be.section",
                    "class": "",
                    "route": "cms.section.index",
                    "icon": "fa-solid fa-layer-group",
                    "acl": "cms.article.section.read"
                },
                "gallery": {
                    "id": "gallery",
                    "name": "__cms::menu.be.gallery",
                    "class": "",
                    "route": "cms.album.index",
                    "icon": "fa-solid fa-images",
                    "acl": "cms.gallery.any"
                },
                "menu": {
                    "id": "menu",
                    "name": "__cms::menu.be.menu",
                    "class": "",
                    "route": "cms.menu.index",
                    "icon": "fa-solid fa-bars",
                    "acl": "cms.menu.read"
                },
                "download": {
                    "id": "download",
                    "name": "__cms::menu.be.download",
                    "class": "",
                    "route": "cms.download.index",
                    "icon": "fa-solid fa-download",
                    "acl": "cms.download.any"
                },
                "tag": {
                    "id": "tag",
                    "name": "__cms::menu.be.tag",
                    "class": "",
                    "route": "cms.tag.index",
                    "icon": "fa-solid fa-tags",
                    "acl": "cms.tag.read"
                },
                "search_term": {
                    "id": "search_term",
                    "name": "__cms::menu.be.search_term",
                    "class": "",
                    "route": "cms.search-term.index",
                    "icon": "fa-solid fa-magnifying-glass",
                    "acl": "cms.search_term.read"
                },
                "analytics": {
                    "id": "analytics",
                    "name": "__cms::menu.be.analytics",
                    "class": "",
                    "route": "cms.analytics",
                    "icon": "fa-solid fa-chart-line",
                    "acl": "cms.analytics.read"
                },
                "settings": {
                    "id": "settings",
                    "name": "__cms::menu.be.settings",
                    "class": "",
                    "route": "cms.settings",
                    "icon": "fa-solid fa-gear",
                    "acl": "cms.settings.read"
                }
            }
        }
    },
    "searchables": {
        "create_page": {
            "name": "__cms::search.create_page",
            "description": "__cms::search.create_page_desc",
            "route": "cms.page.form",
            "icon": "ph ph-file-plus",
            "acl": "cms.page.create",
            "keywords": "__cms::search.create_page_keywords"
        },
        "create_section": {
            "name": "__cms::search.create_section",
            "description": "__cms::search.create_section_desc",
            "route": "cms.section.form",
            "icon": "ph ph-folder-plus",
