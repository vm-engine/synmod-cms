{
    "id": "cms",
    "id_case": {
        "snake": "cms",
        "pascal": "Cms",
        "slug": "cms",
        "studly": "Cms"
    },
    "name": "CMS",
    "description": "Content Management System — static pages, dynamic articles, gallery, and frontend menu management",
    "version": "1.1.12",
    "author": "Adods",
    "email": "theadods@gmail.com",
    "url_prefix": "cms",
    "load_priority": 60,
    "is_package": true,
    "dependencies": {
        "npm": {
            "main": {
                "tinymce": "^7.0",
                "sortablejs": "^1.15"
            },
            "dev": {}
        },
        "composer": {
            "main": {
                "vm-engine/synapps-fallback": "*",
                "vm-engine/synmod-fm": "*",
                "mews/purifier": "^3.4"
            },
            "dev": {}
        }
    },
    "nav": {
        "backend": {
            "name": "__cms::menu.be.parent",
            "position": 5,
            "class": "",
            "icon": "fa-solid fa-newspaper",
            "acl": "cms.any",
            "sub": {
                "page": {
                    "id": "page",
                    "name": "__cms::menu.be.page",
                    "class": "",
                    "route": "cms.page.index",
                    "icon": "fa-solid fa-file-lines",
                    "acl": "cms.page.read"
                },
                "section": {
                    "id": "section",
                    "name": "__cms::menu.be.section",
                    "class": "",
                    "route": "cms.section.index",
                    "icon": "fa-solid fa-layer-group",
                    "acl": "cms.article.section.read"
                },
                "gallery": {
                    "id": "gallery",
                    "name": "__cms::menu.be.gallery",
                    "class": "",
                    "route": "cms.album.index",
                    "icon": "fa-solid fa-images",
                    "acl": "cms.gallery.any"
                },
                "menu": {
                    "id": "menu",
                    "name": "__cms::menu.be.menu",
                    "class": "",
                    "route": "cms.menu.index",
                    "icon": "fa-solid fa-bars",
                    "acl": "cms.menu.read"
                },
                "download": {
                    "id": "download",
                    "name": "__cms::menu.be.download",
                    "class": "",
                    "route": "cms.download.index",
                    "icon": "fa-solid fa-download",
                    "acl": "cms.download.any"
                },
                "tag": {
                    "id": "tag",
                    "name": "__cms::menu.be.tag",
                    "class": "",
                    "route": "cms.tag.index",
                    "icon": "fa-solid fa-tags",
                    "acl": "cms.tag.read"
                }
            }
        }
    },
    "acl": {
        "page": {
            "label": "__cms::acl.page",
            "create": 1,
            "read": 1,
            "update": 1,
            "delete": 1,
            "sub": {
                "publish": {
                    "label": "__cms::acl.page_publish",
                    "create": 0,
                    "read": 1,
                    "update": 1,
                    "delete": 0
                }
            }
        },
        "article": {
            "label": "__cms::acl.article",
            "create": 1,
            "read": 1,
            "update": 1,
            "delete": 1,
            "sub": {
                "publish": {
                    "label": "__cms::acl.article_publish",
                    "create": 0,
                    "read": 1,
                    "update": 1,
                    "delete": 0
                },
                "section": {
                    "label": "__cms::acl.section",
                    "create": 1,
                    "read": 1,
                    "update": 1,
                    "delete": 1
                },
                "category": {
                    "label": "__cms::acl.article_category",
                    "create": 1,
                    "read": 1,
                    "update": 1,
                    "delete": 1
                }
            }
        },
        "gallery": {
            "label": "__cms::acl.gallery",
            "create": 0,
            "read": 0,
            "update": 0,
            "delete": 0,
            "sub": {
                "album": {
                    "label": "__cms::acl.gallery_album",
                    "create": 1,
                    "read": 1,
                    "update": 1,
                    "delete": 1
                },
                "banner": {
                    "label": "__cms::acl.gallery_banner",
                    "create": 1,
                    "read": 1,
                    "update": 1,
                    "delete": 1
                },
                "image": {
                    "label": "__cms::acl.gallery_image",
                    "create": 1,
                    "read": 1,
                    "update": 1,
                    "delete": 1
                }
            }
        },
        "menu": {
            "label": "__cms::acl.menu",
            "create": 1,
            "read": 1,
            "update": 1,
            "delete": 1
        },
        "tag": {
            "label": "__cms::acl.tag",
            "create": 1,
            "read": 1,
            "update": 1,
            "delete": 1
        },
        "download": {
            "label": "__cms::acl.download",
            "create": 0,
            "read": 0,
            "update": 0,
            "delete": 0,
            "sub": {
                "category": {
                    "label": "__cms::acl.download_category",
                    "create": 1,
                    "read": 1,
                    "update": 1,
                    "delete": 1
                },
                "file": {
                    "label": "__cms::acl.download_file",
                    "create": 1,
                    "read": 1,
                    "update": 1,
                    "delete": 1
                }
            }
        },
        "settings": {
            "label": "__cms::acl.settings",
            "create": 0,
            "read": 1,
            "update": 1,
            "delete": 0
        }
    }
}
