includes:
    - ../../vendor/larastan/larastan/extension.neon

parameters:
    level: 7
    paths:
        - src
    tmpDir: build/phpstan
    excludePaths:
        - src/Models/CmsScoutSearchable.php
    ignoreErrors:
        # Livewire helper traits used only by MFC components (resources/views/components/**), which sit outside the analysed paths
        -
            identifier: trait.unused
            paths:
                - src/Traits/WithAccessPicker.php
                - src/Traits/WithCmsAccessChecks.php
