{
    "name": "vm-engine/synmod-cms",
    "description": "CMS module for Laravel Synapse — static pages, dynamic articles, gallery, and frontend menu management",
    "keywords": [
        "laravel",
        "synapse",
        "module",
        "cms",
        "livewire",
        "content-management"
    ],
    "type": "synapse-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Adods",
            "email": "theadods@gmail.com"
        }
    ],
    "require": {
        "livewire/livewire": "^4.0",
        "mews/purifier": "^3.4",
        "vm-engine/synapse": "^3.11",
        "vm-engine/synapps-auth": "^3.0",
        "vm-engine/synapps-fallback": "^2.0",
        "vm-engine/synmod-fm": "^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "VmEngine\\Cms\\": "src/",
            "VmEngine\\Cms\\Seeders\\": "database/seeders/",
            "VmEngine\\Cms\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VmEngine\\Cms\\CmsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../synapse"
        },
        {
            "type": "path",
            "url": "../synapps-auth"
        },
        {
            "type": "path",
            "url": "../synapps-fallback"
        },
        {
            "type": "path",
            "url": "../synmod-fm"
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
